{
  "name": "alchemist",
  "private": true,
  "version": "2.1.0b",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:emulators": "firebase emulators:start --import=./firebase-data --export-on-exit",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:emulators\"",
    "set-admin": "tsx src/infra/scripts/set-admin-claim.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "prebuild": "rm -rf dist",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "sync": "tsx src/infra/scripts/sync-version.ts && git add . && git commit -m \"chore(deploy): sync repository and bump version\" && git push"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@mendable/firecrawl-js": "^4.22.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jsdom": "^28.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.9.0",
    "html2pdf.js": "^0.14.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@vercel/node": "^5.7.15",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "firebase-tools": "^15.17.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5"
  }
}
