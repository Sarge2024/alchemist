generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../specs/ERD.md"
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_stat_statements, pgcrypto, uuid_ossp(map: "uuid-ossp"), vector]
}

model User {
  id                  String                   @id @default(uuid())
  uid                 String                   @unique
  displayName         String
  email               String                   @unique
  photoURL            String?
  whatsapp            String?
  birthDate           String?
  gender              String?
  gastronomyRelation  String[]
  primaryGoals        String[]
  mainMotivation      String?
  dietaryRestrictions String[]
  dietaryPreference   String?
  rejectedIngredients String[]
  infrastructureLevel String?
  kitchenRoutine      String?
  state               String
  country             String
  role                Role                     @default(USER)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  pageAccesses        PageAccess[]
  recipes             Recipe[]
  unansweredQueries   UnansweredQuery[]
  badges              UserBadge[]
  gamificationProfile UserGamificationProfile?
  interactions        UserInteraction[]
  sessions            UserSession[]
}

model Recipe {
  id                String             @id @default(uuid())
  title             String
  description       String?
  image             String?
  momento           String[]
  tipo_prato        String[]
  base_alimento     String[]
  origem            String?
  time              String?
  prepTime          String?
  dietType          String?
  servings          String?
  difficulty        String?
  custo_estimado    String?
  instructions      String[]
  rating            Float              @default(4.5)
  reviewsCount      Int                @default(0)
  isClassic         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  ownerId           String
  slug              String?            @unique
  owner             User               @relation(fields: [ownerId], references: [id])
  recipeIngredients RecipeIngredient[]
}

model GlobalFoodItem {
  id                String             @id @default(uuid())
  name              String             @unique
  category          String?
  source            String             @default("CUSTOM")
  externalId        String?
  calories          Float              @default(0)
  protein           Float              @default(0)
  carbohydrates     Float              @default(0)
  lipids            Float              @default(0)
  baseUnit          String             @default("g")
  baseQuantity      Float              @default(100)
  micronutrients    Json?
  brand             String?
  barcode           String?            @unique
  portionSize       Float?
  portionUnit       String?
  imageUrl          String?
  allergens         String[]
  recipeIngredients RecipeIngredient[]
}

model RecipeIngredient {
  id              String         @id @default(uuid())
  recipeId        String
  foodItemId      String
  quantity        Float
  unit            String
  preparationMode String?
  preparationTime Float?
  foodItem        GlobalFoodItem @relation(fields: [foodItemId], references: [id])
  recipe          Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model UserGamificationProfile {
  id         String @id @default(uuid())
  nivel      Int    @default(1)
  grau       Grau   @default(APRENDIZ)
  xp_total   Int    @default(0)
  userId     String @unique
  meta_nivel Int    @default(100)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserInteraction {
  id        String   @id @default(uuid())
  userId    String
  eventType String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
}

model Badge {
  id              String      @id @default(uuid())
  codigo_evento   String      @unique
  nome            String
  descricao       String?
  url_vercel_blob String?
  userBadges      UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  timestamp DateTime @default(now())
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model AvatarOption {
  id            String   @id @default(uuid())
  codigoAvatar  String   @unique
  tierMinimo    String
  urlVercelBlob String
  criadoEm      DateTime @default(now())
}

model SemanticDocument {
  id        String                 @id @default(uuid())
  title     String
  content   String
  type      String
  embedding Unsupported("vector")?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  url       String?

  @@index([type])
}

model LibraryItem {
  id          String   @id @default(uuid())
  title       String
  description String
  type        String
  category    String
  tags        String[]
  url         String
  thumbnail   String?
  author      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserSession {
  id              String   @id @default(uuid())
  userId          String
  startTime       DateTime @default(now())
  lastPing        DateTime @default(now())
  durationSeconds Int      @default(0)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PageAccess {
  id        String   @id @default(uuid())
  userId    String
  path      String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UnansweredQuery {
  id        String   @id @default(uuid())
  userId    String?
  queryText String
  context   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}

model CulinaryMeasure {
  id             String @id @default(uuid())
  ingredientName String
  measureName    String
  weightInGrams  Float

  @@unique([ingredientName, measureName])
}

enum Role {
  USER
  COLLABORATOR
  ADMIN
}

enum Grau {
  APRENDIZ
  ASSISTENTE
  ALQUIMISTA
  PERITO
  MESTRE_ALQUIMISTA
}
