rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. RECEITAS - TOTALMENTE ABERTO PARA LEITURA (SEM EXCEÇÃO)
    match /recipes/{recipeId} {
      allow read, get, list: if true;
      allow write: if request.auth != null;
    }

    // 2. LOUNGE E MENSAGENS - APENAS LOGADOS
    match /lounge_messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // 3. USUÁRIOS - APENAS O PRÓPRIO OU ADMIN
    match /users/{userId} {
      // Leitura pública (necessário para ver o autor da receita)
      allow read: if true;
      // Apenas o próprio usuário pode editar seus dados
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // REMOVIDO O BLOQUEIO GLOBAL QUE PODIA ESTAR SOBRESCREVENDO AS REGRAS ACIMA
  }
}
