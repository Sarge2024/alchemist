rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. RECEITAS - LEITURA PÚBLICA TOTAL
    // Permite que qualquer visitante navegue e veja as receitas.
    match /recipes/{recipeId} {
      allow read: if true;
      // Escrita exige autenticação.
      allow write: if request.auth != null;
    }

    // 2. USUÁRIOS - LEITURA PÚBLICA DE PERFIS
    // Necessário para exibir o nome/foto do autor da receita.
    match /users/{userId} {
      allow read: if true;
      // Apenas o próprio usuário pode editar seu perfil.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. LOUNGE - PRIVADO PARA MEMBROS
    // Apenas quem está logado pode ler ou escrever no chat.
    match /lounge_messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // 4. BLOQUEIO PADRÃO
    // Qualquer outra coleção não especificada acima é bloqueada por segurança.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
