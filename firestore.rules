rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra específica para a coleção de receitas (em inglês para bater com o código)
    match /recipes/{recipeId} {
      // Permite a leitura para *todos* os usuários, autenticados ou não.
      allow read: if true;
      
      // Permite a escrita (criação, atualização e exclusão) *apenas* para usuários autenticados.
      allow write: if request.auth != null;
    }

    // Regra geral para todas as outras coleções e documentos que não são 'recipes'.
    match /{document=**} {
      // Permite leitura e escrita apenas para usuários autenticados.
      allow read, write: if request.auth != null;
    }
  }
}
