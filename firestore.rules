rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers de Governança ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Valida se o usuário tem uma role específica via Custom Claim (RBAC)
    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      // Prioridade: Email hardcoded ou Claim de admin
      return isVerified() && (
        request.auth.token.email == 'sagacitas.sistemas@gmail.com' || 
        request.auth.token.role == 'admin'
      );
    }

    function isEditor() {
      return hasRole('editor') || isAdmin();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Coleção de Usuários ---
    match /users/{userId} {
      allow get: if isSignedIn();
      
      // Apenas Admins listam todos os usuários
      allow list: if isAdmin();
      
      // Criação: Usuário comum não pode definir sua própria role na criação
      allow create: if isVerified() && isOwner(userId) 
        && (!('role' in request.resource.data) || request.resource.data.role == 'visitante');
        
      // Atualização: Bloqueia alteração de 'role' por não-admins
      allow update: if isVerified() && (
        isAdmin() || (
          isOwner(userId) && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        )
      );
    }

    // --- Coleção de Receitas ---
    match /recipes/{recipeId} {
      allow read: if true;
      
      // Colaboradores ou superiores podem criar receitas
      allow create: if isVerified() && (hasRole('colaborador') || isEditor());
      
      allow update: if isVerified() && (
        isAdmin() || (
          isOwner(resource.data.ownerId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating', 'reviewsCount', 'ownerId'])
        )
      );

      allow delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    // --- Mural de Atas (Fase 2) ---
    match /daily_summaries/{summaryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); // Apenas o sistema/admin gera as atas
    }

    // --- Lounge Gastronômico (v2.1.0) ---
    match /lounge_messages/{messageId} {
      allow read: if isSignedIn();
      
      // Apenas colaboradores ou superiores podem criar mensagens
      allow create: if isVerified() && (
        hasRole('collaborator') || 
        hasRole('colaborador') || 
        isAdmin()
      );
      
      allow update: if isVerified() && (
        // Administradores e Moderadores podem tudo
        isAdmin() || hasRole('moderator') ||
        
        // Qualquer usuário logado pode alternar sua própria reação
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        ) ||
        
        // Moderação de status
        (
          (hasRole('moderator') || isAdmin()) && 
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
        )
      );

      // Apenas Admin ou o próprio autor pode deletar (se pendente)
      allow delete: if isAdmin() || (
        isOwner(resource.data.senderId) && resource.data.status == 'pending'
      );
    }
  }
}
