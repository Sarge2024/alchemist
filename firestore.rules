rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. RECEITAS - LEITURA PÚBLICA TOTAL
    // Permite que qualquer visitante navegue e veja as receitas.
    match /recipes/{recipeId} {
      allow read: if true;
      // Escrita exige autenticação.
      allow write: if request.auth != null;
    }

    // 2. USUÁRIOS - LEITURA PÚBLICA DE PERFIS
    // Necessário para exibir o nome/foto do autor da receita.
    match /users/{userId} {
      allow read: if true;
      // Apenas o próprio usuário pode editar seu perfil.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. LOUNGE - PRIVADO PARA MEMBROS
    // Apenas quem está logado pode ler ou escrever no chat.
    match /lounge_messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.senderId || 
        request.auth.token.email == 'sagacitas.sistemas@gmail.com'
      );
    }

    // 4. ATAS DIÁRIAS - LEITURA PÚBLICA, VOTOS PARA MEMBROS
    match /daily_summaries/{ataId} {
      allow read: if true;
      allow update: if request.auth != null;
    }

    // 5. AVALIAÇÕES - LEITURA PÚBLICA, ESCRITA PARA MEMBROS
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.token.email == 'sagacitas.sistemas@gmail.com'
      );
    }

    // 6. ACERVO - LEITURA PÚBLICA, ESCRITA ADMIN
    match /library/{itemId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'sagacitas.sistemas@gmail.com';
    }

    // 7. BLOQUEIO PADRÃO
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
