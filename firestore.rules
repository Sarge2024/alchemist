rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // TESTE DE EMERGÊNCIA: ABRIR TUDO PARA LEITURA
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Regra específica para recipes (redundante para garantir)
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
