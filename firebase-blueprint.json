{
  "entities": {
    "Recipe": {
      "title": "Recipe",
      "description": "Uma receita culinária no Alquimia do Prato",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Título da receita" },
        "description": { "type": "string", "description": "Breve descrição ou história da receita" },
        "image": { "type": "string", "description": "URL da imagem da receita" },
        "momento": { 
          "type": "array", 
          "items": { "type": "string", "enum": ["Café da Manhã", "Brunch", "Almoço", "Lanche / Chá da Tarde", "Jantar", "Ceia", "Entradas", "Básicas", "Petiscos&Food Tricks", "Bebidas"] },
          "description": "Momentos de consumo ideais" 
        },
        "tipo_prato": {
          "type": "array",
          "items": { "type": "string", "enum": ["Assados", "Frituras", "Grelhados", "Sopas e Caldos", "Cremes e Purés", "Massas e Risotos", "Saladas e Pratos Frios", "Cozidos / Guisados", "Padaria e Pastelaria", "Bebidas", "Doces e Sobremesas"] },
          "description": "Categoria e Técnica dominante"
        },
        "base_alimento": {
          "type": "array",
          "items": { "type": "string", "enum": ["Carnes", "Frutos do Mar", "Vegetais e Legumes", "Ovos e Laticínios", "Grãos e Leguminosas"] },
          "description": "Ingrediente principal ou base"
        },
        "origem": { 
          "type": "string", 
          "enum": ["Latino-Americana", "Brasileira", "Mexicana", "Argentina", "Asiática", "Japonesa", "Chinesa", "Tailandesa", "Coreana", "Indiana", "Europeia", "Italiana", "Francesa", "Portuguesa", "Espanhola", "Árabe / Médio Oriente", "Americana"],
          "description": "Origem cultural/geográfica" 
        },
        "time": { "type": "string", "description": "Tempo total (ex: 45 min)" },
        "prepTime": { "type": "string", "description": "Tempo de preparação (ex: 15 min)" },
        "dietType": { "type": "string", "enum": ["Convencional", "Vegana", "Vegetariana", "Low Carb", "Keto", "Sem Glúten", "Fit"], "description": "Classificação da dieta" },
        "servings": { "type": "string", "description": "Número de porções" },
        "difficulty": { "type": "string", "enum": ["Fácil", "Médio", "Difícil"], "description": "Nível de dificuldade" },
        "custo_estimado": { "type": "string", "enum": ["$", "$$", "$$$", "$$$$"], "description": "Custo estimado" },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "quantity": { "type": "string" },
              "group": { "type": "string", "description": "Grupo opcional (ex: Massa, Recheio, Cobertura)" }
            },
            "required": ["name", "quantity"]
          },
          "description": "Lista de ingredientes agrupados"
        },
        "instructions": { "type": "array", "items": { "type": "string" }, "description": "Passos do modo de preparo" },
        "ownerId": { "type": "string", "description": "UID do usuário que criou a receita" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Data de criação" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Data da última atualização" },
        "rating": { "type": "number", "description": "Avaliação média" },
        "reviewsCount": { "type": "number", "description": "Número de avaliações" },
        "isClassic": { "type": "boolean", "description": "Se é uma receita clássica com história registrada" }
      },
      "required": ["title", "momento", "tipo_prato", "base_alimento", "ingredients", "instructions", "ownerId"]
    },
    "User": {
      "title": "User",
      "description": "Perfil de usuário/colaborador do Alquimia do Prato",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "UID do Firebase Auth" },
        "displayName": { "type": "string", "description": "Nome completo" },
        "email": { "type": "string", "description": "E-mail de contato" },
        "photoURL": { "type": "string", "description": "URL da foto de perfil" },
        "whatsapp": { "type": "string", "description": "Número do WhatsApp (opcional)" },
        "state": { "type": "string", "description": "Estado" },
        "country": { "type": "string", "description": "País" },
        "role": { "type": "string", "enum": ["user", "collaborator", "admin"], "description": "Papel do usuário" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "state", "country"]
    }
  },
  "firestore": {
    "recipes": {
      "schema": "Recipe",
      "description": "Coleção central de todas as receitas do Alquimia do Prato"
    },
    "users": {
      "schema": "User",
      "description": "Perfil dos usuários e colaboradores"
    }
  }
}
